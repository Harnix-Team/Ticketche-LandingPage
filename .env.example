NEXT_PUBLIC_APP_URL=https://ticketche.com
NEXT_PUBLIC_API_URL=https://api.ticketche.com/api/v2
# Widget de chat : nixia (defaut), tawk ou none. Un seul actif a la fois, fige au build.
NEXT_PUBLIC_CHATBOT_PROVIDER=nixia
# Suggestions personnalisees : cree une session invite apres consentement du visiteur (0 = classement non personnalise).
NEXT_PUBLIC_RECO_GUEST_SESSION=0
